generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  user_id                    Int       @id @default(autoincrement())
  full_name                  String
  password_hash              String?   
  email                      String    @unique
  role                       Role      @default(learner)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  lastLogin                  DateTime?
  is_active                  Boolean   @default(true)
  resetPasswordToken         String?   @unique
  resetPasswordTokenExpiresAt DateTime?
  activeEmailToken           String?   @unique
  activeEmailTokenExpiresAt  DateTime?
  isEmailVerified            Boolean   @default(false)
  activeAccountToken         String?
  activeAccountTokenExpiresAt DateTime?
  is_2fa_enabled             Boolean   @default(false)  
  two_fa_secret              String?  
  backup_codes               String[]  
  
  googleId                   String?   @unique
  googleAccessToken          String?
  googleRefreshToken         String?
  googleProfile              Json?    
  authProvider               String?  
  
  courses       Courses[]
  enrollments   Enrollments[]
  payments      Payments[]
  reviews       Reviews[]
  comments      Comment[]
  attempts      Attempt[]
  userProgress  UserProgress[]
  likes         Like[]
  bookmarks     Bookmark[]
  seen          Seen[]
  assignments         Assignments[]          @relation("InstructorAssignments")
  submissions         AssignmentSubmission[] @relation("StudentSubmissions")
  Article Article[]
  @@index([email])
  @@index([googleId])
  @@map("users")
  AssignmentSubmission AssignmentSubmission[]
  Assignments Assignments[]
  SupportTicket SupportTicket[]
  SupportTicketMessage SupportTicketMessage[]
  SupportTicketAccessToken SupportTicketAccessToken[]
}

model Courses {
  course_id         Int            @id @default(autoincrement())
  instructor_id     Int
  title             String
  description       String?
  course_img        String
  category          String?
  price             Float          @default(0.00)
  is_published      Boolean        @default(false)
  course_type       CourseType?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  learning_outcomes String[]
  start_date        DateTime       @default(now())
  end_date          DateTime       @default(now())
  instructor        Users          @relation(fields: [instructor_id], references: [user_id])
  lessons           Lessons[]
  enrollments       Enrollments[]
  reviews           Reviews[]
  quizzes           Quizzes[]
  payments          Payments[]
  userProgress      UserProgress[]
  likes             Like[]
  bookmarks         Bookmark[]
  assignments       Assignments[]
  @@map("courses")
  Notifications Notifications[]
}

model InstructorsApplications {
  application_id        Int                @id @default(autoincrement())
  application_status    ApplicationStatus  @default(pending)
  submitted_at          DateTime           @default(now())
  reviewed_at           DateTime?
  notes                 String?
  
  full_name            String
  email                String
  phone_number         String?
  bio                  String?
  profile_picture_url  String?
  
  expertise_area       String[]           
  certifications       String[]           
  years_of_experience  Int                
  
  education_background String             
  institution          String             
  degree               String             
  
  previous_courses     String[]           
  teaching_style       String?            
  language_skills      String[]           
  
  preferred_schedule   String?            
  preferred_course_type CourseType?       
  
  @@map("instructor_applications")
}

model Article {
  article_id       Int             @id @default(autoincrement())
  author_id        Int
  title            String
  slug             String          @unique
  content          Json            
  search_text      String          @db.Text 
  excerpt          String?         @db.VarChar(300)
  status           ContentStatus   @default(draft)
  content_type     ArticleType     @default(tutorial)
  published_at     DateTime?
  category         String?
  tags             String[]
  featured_image   String?
  word_count       Int?
  seo_title        String?
  seo_description  String?
  seo_keywords     String[]
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  deleted_at       DateTime?
  is_article_approved Boolean @default(false)

  author           Users           @relation(fields: [author_id], references: [user_id])
  comments         Comment[]
  categories       Category[]
  content_blocks   ContentBlock[]
  likes            Like[]
  bookmarks        Bookmark[]
  seen             Seen[]
  seen_count       Int             @default(0)

  @@index([slug], type: Hash)
  @@index([published_at])
  @@map("articles")
  article_approvel ArticleApporvel[]
}

model Category {
  category_id   Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  description   String?
  articles      Article[]

  @@map("categories")
}

enum ContentStatus {
  draft
  published
  archived
  deleted
}


model Comment {
  comment_id     Int            @id @default(autoincrement())
  content        String
  author_id      Int
  article_id     Int
  parent_id      Int?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  status         CommentStatus  @default(published)

  author        Users          @relation(fields: [author_id], references: [user_id])
  article       Article        @relation(fields: [article_id], references: [article_id])

  @@index([article_id])
  @@index([parent_id])
  @@index([created_at])
  
  @@map("comments")
}

enum CommentStatus {
  published
  hidden
  deleted
}

model ContentBlock {
  block_id      Int            @id @default(autoincrement())
  article_id    Int
  order         Int
  block_type    BlockType
  content       String?
  code_language String?
  code_content  String?
  image_url     String?
  image_caption String?
  video_url     String?
  video_duration Int?
  quiz_id       Int?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  article       Article        @relation(fields: [article_id], references: [article_id])

  @@map("content_blocks")
}

enum BlockType {
  TEXT
  CODE
  IMAGE
  WARNING
  TIP
  QUOTE
  HEADING
  DIVIDER
}

enum ArticleType {
  tutorial
  howto
  explainer
  news
  opinion
  reference
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum CourseType {
  free
  paid
}

enum Role {
  learner
  admin
  instructor
  support
  moderator
}

model Lessons {
  lesson_id    Int      @id @default(autoincrement())
  course_id    Int
  title        String
  content      String
  description  String
  video_url    String
  attachment   String?
  is_lesson_approved Boolean @default(false)
  is_free      Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  lesson_order Int

  course       Courses        @relation(fields: [course_id], references: [course_id])
  userProgress UserProgress[]
  lessonsApprovel LessonsApprovel[]
  

  @@map("lessons")
}

enum ApprovelStatus{
  pending
  approved
  rejected
}

model LessonsApprovel{
  lessoon_approvel_id Int @id @default(autoincrement())
  lesson_id Int
  approved_by Int?
  apporval_date DateTime? 
  status ApprovelStatus @default(pending)
  reason String?
  lesson Lessons @relation(fields: [lesson_id], references: [lesson_id])
  @@map("lessons_approvel")

}

model ArticleApporvel{
  article_approvel_id Int @id @default(autoincrement())
  article_id Int
  approved_by Int?
  apporval_date DateTime? 
  reason String?
  status ApprovelStatus @default(pending)
  article Article @relation(fields: [article_id], references: [article_id])
  @@map("articles_approvel")

}

model UserProgress {
  progress_id   Int      @id @default(autoincrement())
  user_id       Int
  course_id     Int
  lesson_id     Int?
  progress      Float    @default(0.0)
  is_completed  Boolean  @default(false)
  last_accessed DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user   Users    @relation(fields: [user_id], references: [user_id])
  course Courses  @relation(fields: [course_id], references: [course_id])
  lesson Lessons? @relation(fields: [lesson_id], references: [lesson_id])

  @@map("user_progress")
}

model Payments {
  payment_id               Int           @id @default(autoincrement())
  user_id                  Int
  amount                   Float
  sessionId                String        @default("")
  stripe_payment_intent_id String?       @unique
  payment_status           PaymentStatus @default(pending)
  payment_method           PaymentMethod @default(card)
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt
  course_id                Int?

  user   Users    @relation(fields: [user_id], references: [user_id])
  course Courses? @relation(fields: [course_id], references: [course_id])

  @@map("payments")
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum PaymentMethod {
  card
  bank_transfer
}

model Enrollments {
  enrollment_id   Int              @id @default(autoincrement())
  user_id         Int
  course_id       Int
  enrollment_date DateTime         @default(now())
  status          EnrollmentStatus @default(active)
  access_granted  Boolean          @default(false)
  access_token    String?

  user   Users   @relation(fields: [user_id], references: [user_id])
  course Courses @relation(fields: [course_id], references: [course_id])

  @@map("enrollments")
}

enum EnrollmentStatus {
  active
  completed
  dropped
}
model Reviews {
  review_id   Int      @id @default(autoincrement())
  user_id     Int
  course_id   Int
  rating      Int
  review_text String?
  created_at  DateTime @default(now())

  user   Users   @relation(fields: [user_id], references: [user_id])
  course Courses @relation(fields: [course_id], references: [course_id])

  @@map("reviews")
}

model Quizzes {
  quiz_id      Int            @id @default(autoincrement())
  course_id    Int
  title        String
  description  String?
  duration     Int            @default(60) 
  max_attempts Int            @default(1) 
  is_published Boolean        @default(false)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  course       Courses        @relation(fields: [course_id], references: [course_id])
  questions    Question[]     
  Attempt      Attempt[]

  @@map("quizzes")
}

model Question {
  question_id   Int            @id @default(autoincrement())
  quiz_id       Int
  question_text String
  question_type QuestionType
  marks         Int            @default(1)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  quiz          Quizzes        @relation(fields: [quiz_id], references: [quiz_id])
  choices       Choice[]       
  Answer        Answer[]

  @@map("questions")
}

enum QuestionType {
  mcq        
  truefalse  
  text       
}

model Choice {
  choice_id    Int      @id @default(autoincrement())
  question_id  Int
  choice_text  String
  is_correct   Boolean  @default(false)

  question     Question @relation(fields: [question_id], references: [question_id])
  Answer       Answer[]

  @@map("choices")
}

model Attempt {
  attempt_id   Int           @id @default(autoincrement())
  user_id      Int
  quiz_id      Int
  start_time   DateTime      @default(now())
  end_time     DateTime?
  score        Float         @default(0)
  user         Users         @relation(fields: [user_id], references: [user_id])
  quiz         Quizzes       @relation(fields: [quiz_id], references: [quiz_id])
  answers      Answer[]      

  @@map("quiz_attempts")
}

model Answer {
  answer_id    Int      @id @default(autoincrement())
  attempt_id   Int
  question_id  Int
  answer_text  String?
  answer_id_choice Int?

  attempt      Attempt @relation(fields: [attempt_id], references: [attempt_id])
  question     Question    @relation(fields: [question_id], references: [question_id])
  choice       Choice?     @relation(fields: [answer_id_choice], references: [choice_id])

  @@map("answers")
}

model Like {
  like_id    Int      @id @default(autoincrement())
  user_id    Int
  article_id Int?
  course_id  Int?
  created_at DateTime @default(now())

  user   Users   @relation(fields: [user_id], references: [user_id])
  article Article? @relation(fields: [article_id], references: [article_id])
  course  Courses? @relation(fields: [course_id], references: [course_id])

  @@unique([user_id, article_id]) 
  @@unique([user_id, course_id])  
  @@map("likes")
}

model Bookmark {
  bookmark_id Int      @id @default(autoincrement())
  user_id     Int
  article_id  Int?
  course_id   Int?
  created_at  DateTime @default(now())

  user   Users   @relation(fields: [user_id], references: [user_id])
  article Article? @relation(fields: [article_id], references: [article_id])
  course  Courses? @relation(fields: [course_id], references: [course_id])

  @@unique([user_id, article_id]) 
  @@unique([user_id, course_id])  
  @@map("bookmarks")
}

model Seen {
  seen_id    Int      @id @default(autoincrement())
  user_id    Int
  article_id Int
  seen_at    DateTime @default(now())

  user   Users   @relation(fields: [user_id], references: [user_id])
  article Article @relation(fields: [article_id], references: [article_id])

  @@unique([user_id, article_id]) 
  @@map("seen")
}

model Assignments {
  assignment_id    Int       @id @default(autoincrement())
  course_id       Int
  instructor_id   Int
  title           String
  description     String
  start_date      DateTime
  points          Int
  end_date        DateTime
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  course          Courses   @relation(fields: [course_id], references: [course_id])
  instructor      Users     @relation(fields: [instructor_id], references: [user_id])
  submissions     AssignmentSubmission[]

  @@map("assignments")
  Users Users[] @relation("InstructorAssignments")
}

model AssignmentSubmission {
  submission_id   Int       @id @default(autoincrement())
  assignment_id   Int
  student_id      Int
  file_url        String
  submitted_at    DateTime  @default(now())
  grade          Float?
  feedback       String?

  assignment      Assignments @relation(fields: [assignment_id], references: [assignment_id])
  student         Users       @relation(fields: [student_id], references: [user_id])

  @@map("assignment_submissions")
  Users Users[] @relation("StudentSubmissions")
}
model SupportTicketAccessToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  ticket_id   Int
  user_id     Int
  expires_at  DateTime
  is_used     Boolean  @default(false)
  created_at  DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticket_id], references: [ticket_id])
  user        Users @relation(fields: [user_id], references: [user_id])

  @@map("support_ticket_access_tokens")
}

model SupportTicket {
  ticket_id     Int      @id @default(autoincrement())
  user_id       Int
  assign_to     Int? 
  title         String
  description   String
  status        SupportStatus @default(open)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  user Users @relation(fields: [user_id], references: [user_id])
  accessTokens SupportTicketAccessToken[]

  @@map("support_tickets")
  SupportTicketMessage SupportTicketMessage[]
}

enum SupportStatus {
  open
  closed
  in_progress
}

model SupportTicketMessage {
  message_id    Int      @id @default(autoincrement())
  ticket_id     Int
  user_id       Int
  is_read       Boolean  @default(false)
  message       String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  ticket SupportTicket @relation(fields: [ticket_id], references: [ticket_id])
  user Users @relation(fields: [user_id], references: [user_id])

  @@map("support_ticket_messages")
}
model Notifications {
  notification_id Int @id @default(autoincrement())
  message String @default("")
  type NotificationType 
  is_read Boolean @default(false)
  course_with_id Int 
  created_at DateTime @default(now())
  course Courses @relation(fields: [course_with_id], references: [course_id])
  @@map("notifications")
}

enum NotificationType {
  ASSIGNMENT_NEW
  ASSIGNMENT_DEADLINE
  QUIZ_NEW
  QUIZ_ENDING
}
